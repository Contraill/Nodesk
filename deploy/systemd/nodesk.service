[Unit]
Description=Nodesk network map (collector + API)
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=NODESK_HOME=@NODESK_HOME@
Environment=PYTHONPATH=@NODESK_HOME@/app
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@NODESK_HOME@
ExecStart=/usr/bin/python3 -m nodesk serve
Restart=always
RestartSec=15
Nice=10
IOSchedulingClass=idle
# Runs as root: ARP scan and passive listening (raw sockets), Docker socket, tailscale.
MemoryMax=150M

[Install]
WantedBy=multi-user.target
