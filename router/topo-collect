#!/bin/sh
# Nodesk: router tarafı veri toplayıcı (salt okunur).
# /usr/sbin/nodesk-agent tarafından 5 dakikada bir çalıştırılır; çıktısı Pi'ye gönderilir.
# Hiçbir ayarı değiştirmez; sadece okur ve yazdırır.
#
# İlk kurulum (bir kez): haritada Ayarlar > Ajanlar > Kurulum komutu, router'da çalıştırılır.
# Sonraki sürümleri ajan Pi'den kendisi alır.

TOPO_VERSION=9

echo "#VERSION"
echo "$TOPO_VERSION"

echo "#ADDR"
ip -4 -o addr show 2>/dev/null

echo "#ROUTE"
# varsayılan rota: modemin (WAN tarafındaki geçidin) adresi buradan bulunur
ip -4 route show default 2>/dev/null

echo "#LEASES"
cat /tmp/dhcp.leases 2>/dev/null

echo "#NEIGH"
ip -4 neigh show 2>/dev/null

echo "#ARPSCAN_WAN"
# H3600P ağı: router'ın WAN arayüzü bu ağa doğrudan bağlı (L2).
# ~256 ARP paketi, ~2 saniye. Bağlantı tablosuna kayıt açmaz.
WAN=$(arp-scan -I wan --localnet --quiet --plain --retry=2 2>/dev/null)
echo "$WAN"

echo "#NAMES"
# Router'ın kendi ağlarındaki (WAN tarafı + LAN) cihazlara ad sorusu. Her IP'ye ilk görüldüğünde
# ve sonra günde bir kez: bir NetBIOS (UDP 137) ve bir mDNS (UDP 5353) paketi; ağa da tek bir
# mDNS servis sorusu (Apple, AirPlay, Chromecast, HomeKit, yazıcı). Port taraması değil;
# Tailscale'e hiç gitmez. Yanıtlar ham (hex) dinleyicinin dosyasına eklenir, Pi ayrıştırır.
# ucode-mod-socket yoksa atlanır.
PROBED=/tmp/nodesk-probed.txt   # ilk satır: listenin başladığı an (epoch); sonra sorulan IP'ler
HEARD=/tmp/nodesk-heard.txt
rm -f /tmp/nodesk-names.txt     # eski sürümün önbelleği
if [ -f "$PROBED" ] && [ $(( $(date +%s) - $(head -n 1 "$PROBED") )) -ge 86400 ]; then
    rm -f "$PROBED"
fi
if [ -f /usr/lib/ucode/socket.so ] && command -v ucode >/dev/null; then
    IPS=$( { echo "$WAN" | awk '{ print $1 }'
             ip -4 neigh show dev br-lan 2>/dev/null | awk '$0 !~ /FAILED|INCOMPLETE/ { print $1 }'; } |
           grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u | head -n 64)
    if [ -f "$PROBED" ]; then NEW=$(echo "$IPS" | grep -vxF -f "$PROBED"); else NEW=$IPS; fi
    if [ -n "$NEW" ]; then
        cat > /tmp/nodesk-names.uc <<'UC'
import * as socket from 'socket';
function u16(n) { return chr(n >> 8, n & 255); }
function hdr(id, qd) { return u16(id) + u16(0) + u16(qd) + u16(0) + u16(0) + u16(0); }
function qname(n) { let o = ''; for (let p in split(n, '.')) o += chr(length(p)) + p; return o + chr(0); }
let nb = socket.create(socket.AF_INET, socket.SOCK_DGRAM), md = socket.create(socket.AF_INET, socket.SOCK_DGRAM);
let socks = [nb, md], i = 0;
for (let ip in ARGV) {
	i++;
	nb.send(hdr(i, 1) + chr(0x20) + 'CK' + 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' + chr(0) + u16(0x21) + u16(1), 0, { address: ip, port: 137 });
	md.send(hdr(i, 2) + qname(join('.', reverse(split(ip, '.'))) + '.in-addr.arpa') + u16(12) + u16(1)
		+ qname('_services._dns-sd._udp.local') + u16(12) + u16(1), 0, { address: ip, port: 5353 });
}
// Servis türleri sorusu her iki ağa (arayüze bağlı soketten), yanıtlar aynı sokete gelir
let types = ['_companion-link._tcp', '_device-info._tcp', '_airplay._tcp', '_raop._tcp',
	'_googlecast._tcp', '_hap._tcp', '_ipp._tcp', '_spotify-connect._tcp'];
let q = hdr(0, length(types));
for (let t in types) q += qname(t + '.local') + u16(12) + u16(1);
for (let dev in ['wan', 'br-lan']) {
	let s = socket.create(socket.AF_INET, socket.SOCK_DGRAM);
	if (s && s.setopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, dev)) {
		s.send(q, 0, { address: '224.0.0.251', port: 5353 });
		push(socks, s);
	}
}
let end = time() + 3;
while (time() < end) {
	for (let ev in socket.poll(500, ...socks) ?? []) {
		if (!(ev[1] & socket.POLLIN)) continue;
		let a = {}, d = ev[0].recv(4096, socket.MSG_DONTWAIT, a);
		if (d) print(a.address, ' ', ev[0] == nb ? 'nb' : 'mdns', ' ', hexenc(d), '\n');
	}
}
UC
        # shellcheck disable=SC2086  # IP listesi kelimelere bölünsün
        ucode /tmp/nodesk-names.uc $NEW >> "$HEARD" 2>/dev/null
        rm -f /tmp/nodesk-names.uc
        [ -f "$PROBED" ] || date +%s > "$PROBED"
        echo "$NEW" >> "$PROBED"
    fi
fi
# nodesk-listen'in ve ad sorusunun son rapordan beri duyduğu yayınlar (Pi kalıcı saklar)
if [ -f "$HEARD" ] && mv "$HEARD" "$HEARD.sending"; then
    cat "$HEARD.sending"
    rm -f "$HEARD.sending"
fi

echo "#LISTEN"
# Router'ın dinlediği TCP portları (LuCI, DNS, SSH...): sadece yerel adres:port, onaltılık
for f in /proc/net/tcp /proc/net/tcp6; do
    [ -r "$f" ] && awk 'NR > 1 && $4 == "0A" { print $2 }' "$f"
done 2>/dev/null

echo "#EXITCLIENTS"
# Bu router'ı exit node olarak kullananlar: son rapordan beri buradan internete YENİ bağlantı
# açan tailnet cihazları (bağlantı tablosu, salt okunur). Exit kapanınca eski bağlantılar tabloda
# bir süre kalır ama yenisi açılmaz. Aynı süzgeç agents.py'deki Linux ajanında.
awk -v prev=/tmp/nodesk-exit.prev -v nxt=/tmp/nodesk-exit.next '
BEGIN { first = 1; while ((getline l < prev) > 0) { seen[l] = 1; first = 0 }; printf "" > nxt }
{ p = 0; for (i = 1; i <= NF; i++) if ($i ~ /^(tcp|udp|icmp|udplite|sctp|gre)$/) { p = i; break }
  if (!p) next
  s = ""; d = ""; sp = ""; dp = ""
  for (i = p + 3; i <= NF; i++) {
    if (s == "" && $i ~ /^src=/) s = substr($i, 5); else if (d == "" && $i ~ /^dst=/) d = substr($i, 5)
    else if (sp == "" && $i ~ /^sport=/) sp = substr($i, 7); else if (dp == "" && $i ~ /^dport=/) dp = substr($i, 7) }
  if (s ~ /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./ && d ~ /^[0-9.]+$/ &&
      d !~ /^(10|127|0|100|169\.254|192\.168|172\.(1[6-9]|2[0-9]|3[01])|22[4-9]|23[0-9]|24[0-9]|25[0-5])\./) {
    k = s " " d " " $p " " sp " " dp; print k > nxt
    if (!first && !(k in seen)) n[s]++ } }
END { for (c in n) print c, n[c] }' /proc/net/nf_conntrack 2>/dev/null
mv -f /tmp/nodesk-exit.next /tmp/nodesk-exit.prev 2>/dev/null

echo "#EXITNODE"
tailscale debug prefs 2>/dev/null | sed -n 's/.*"ExitNodeID": "\([^"]*\)".*/\1/p'

echo "#END"
