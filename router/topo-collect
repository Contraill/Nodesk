#!/bin/sh
# nodesk: router tarafı veri toplayıcı (salt okunur).
# Pi'deki kısıtlı SSH anahtarı sadece bu scripti çalıştırabilir
# (/etc/dropbear/authorized_keys içindeki command= ayarı).
# Hiçbir ayarı değiştirmez; sadece okur ve yazdırır.
#
# Kurulum/güncelleme: Laptop'tan
#   ssh pi@100.64.0.1 sudo nodesk router-script | ssh root@100.64.0.2 sh

TOPO_VERSION=1

echo "#VERSION"
echo "$TOPO_VERSION"

echo "#ADDR"
ip -4 -o addr show 2>/dev/null

echo "#LEASES"
cat /tmp/dhcp.leases 2>/dev/null

echo "#NEIGH"
ip -4 neigh show 2>/dev/null

echo "#ARPSCAN_WAN"
# H3600P ağı: router'ın WAN arayüzü bu ağa doğrudan bağlı (L2).
# ~256 ARP paketi, ~2 saniye. Bağlantı tablosuna kayıt açmaz.
arp-scan -I wan --localnet --quiet --plain --retry=2 2>/dev/null

echo "#EXITNODE"
tailscale debug prefs 2>/dev/null | sed -n 's/.*"ExitNodeID": "\([^"]*\)".*/\1/p'

echo "#END"
