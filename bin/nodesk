#!/usr/bin/env bash
# Nodesk yönetim aracı (Pi'de çalışır).
#
#   sudo nodesk install              ilk kurulum / onarım (tekrar çalıştırmak güvenli)
#   sudo nodesk update               depodan son sürümü al ve uygula
#   sudo nodesk rollback             bir önceki sürüme dön
#   sudo nodesk status               durum özeti
#   sudo nodesk run                  şimdi tara
#   sudo nodesk logs [N]             son N günlük satırı
#   sudo nodesk router-script        router ajanı kurulum scripti (Laptop'tan kullanılır)
#   sudo nodesk agent add <ad>       sunucu ajanı ekle, kurulum komutunu göster
#   sudo nodesk agent list|remove    ajanları listele / sil
#   sudo nodesk uninstall            kaldır (veri klasörünü silmez)
set -euo pipefail

NODESK_HOME="${NODESK_HOME:-/DATA/AppData/nodesk}"
APP="$NODESK_HOME/app"
KEYS="$NODESK_HOME/keys"
DATA="$NODESK_HOME/data"
WWW="$NODESK_HOME/www"
APP_ID="nodesk-web"
PORT=8088
API="http://127.0.0.1:8089"
BRANCH="${NODESK_BRANCH:-main}"
UNIT_DIR="${NODESK_UNIT_DIR:-/etc/systemd/system}"
PI_TS_IP_FALLBACK="100.64.0.1"
ROUTER_TS_IP="100.64.0.2"

if [ -t 1 ]; then G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; B=$'\e[1m'; N=$'\e[0m'; else G=''; Y=''; R=''; B=''; N=''; fi
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*"; }
die()  { printf '%s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
step() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }

need_root() { [ "$(id -u)" -eq 0 ] || die "Bu komut root ister: sudo nodesk ${1:-}"; }
app_version() { cat "$APP/VERSION" 2>/dev/null || echo "?"; }
app_rev() { git -C "$APP" rev-parse --short HEAD 2>/dev/null || echo "?"; }
pi_ip() { tailscale ip -4 2>/dev/null | head -1 || true; }
render() { sed "s#@NODESK_HOME@#$NODESK_HOME#g" "$1"; }
py() { PYTHONPATH="$APP" NODESK_HOME="$NODESK_HOME" python3 "$@"; }
api() { curl -fsS -m 15 "$@"; }
api_json() {
    local m="$1" p="$2" body="${3:-}"
    [ -n "$body" ] || body='{}'
    curl -fsS -m 15 -X "$m" -H 'Content-Type: application/json' -d "$body" "$API$p"
}

# ------------------------------------------------------------------ kontroller
web_running() {
    [ -n "$(docker ps --filter "label=com.docker.compose.project=$APP_ID" --filter status=running -q 2>/dev/null)" ]
}

preflight() {
    step "Ön kontroller"
    [ -d "$APP/.git" ] || die "$APP bir git deposu değil. Önce depoyu oraya klonla (README'deki ilk kurulum)."
    python3 -c 'import sys, tomllib; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null \
        || die "Python 3.11+ gerekli (tomllib)."
    ok "python3 $(python3 -c 'import platform; print(platform.python_version())')"
    local missing=()
    for c in git tailscale docker arp-scan ss systemctl systemd-run curl; do
        command -v "$c" >/dev/null 2>&1 || missing+=("$c")
    done
    [ ${#missing[@]} -eq 0 ] || die "Eksik araç(lar): ${missing[*]}  (örn. sudo apt install arp-scan)"
    ok "git, tailscale, docker, arp-scan, ss, curl mevcut"
    [ -r /usr/share/arp-scan/ieee-oui.txt ] && ok "üretici veritabanı mevcut" \
        || warn "/usr/share/arp-scan/ieee-oui.txt yok; üretici adları boş kalır"
    if web_running; then
        ok "port $PORT: Nodesk web arayüzü zaten çalışıyor"
    else
        local users
        users=$(docker ps --filter "publish=$PORT" --format '{{.Names}}' 2>/dev/null || true)
        [ -z "$users" ] || die "$PORT portunu başka bir container kullanıyor: $users"
        if ss -ltnH "sport = :$PORT" 2>/dev/null | grep -q .; then
            die "$PORT portu başka bir süreç tarafından kullanılıyor (ss -ltnp | grep :$PORT)"
        fi
        ok "port $PORT uygun"
    fi
    if ss -ltnpH "sport = :8089" 2>/dev/null | grep -v python3 | grep -q .; then
        die "8089 portu (Nodesk API, sadece 127.0.0.1) başka bir süreç tarafından kullanılıyor"
    fi
}

# ------------------------------------------------------------------ kurulum adımları
migrate_config() {
    # Örnek dosyaya sonradan eklenen bölümleri kullanıcının config.toml'una ekle (varsa dokunma)
    py - "$APP/config.example.toml" "$NODESK_HOME/config.toml" <<'PY'
import re, sys, tomllib
ex_path, cfg_path = sys.argv[1], sys.argv[2]
ex_text = open(ex_path, encoding="utf-8").read()
cfg_text = open(cfg_path, encoding="utf-8").read()
cfg = tomllib.loads(cfg_text)
added = []
for table in ("apps",):
    if table in cfg:
        continue
    m = re.search(rf"(?ms)^(#[^\n]*\n)*\[{table}\]\n.*?(?=^\[|\Z)", ex_text)
    if m:
        cfg_text = cfg_text.rstrip("\n") + "\n\n" + m.group(0).rstrip("\n") + "\n"
        added.append(table)
if added:
    tomllib.loads(cfg_text)  # bozuk dosya yazma
    open(cfg_path, "w", encoding="utf-8").write(cfg_text)
    print("config.toml'a eklendi: " + ", ".join(added))
PY
}

setup_dirs() {
    step "Klasörler ve ayarlar"
    mkdir -p "$KEYS" "$DATA" "$WWW"
    chmod 700 "$KEYS" "$DATA"
    chmod 755 "$WWW"
    if [ -f "$NODESK_HOME/config.toml" ]; then
        local msg; msg=$(migrate_config)
        [ -n "$msg" ] && ok "$msg"
        ok "config.toml korunuyor"
    else
        cp "$APP/config.example.toml" "$NODESK_HOME/config.toml"
        ok "config.toml oluşturuldu (örnekten)"
    fi
    if [ -f "$KEYS/router_ed25519" ]; then
        rm -f "$KEYS/router_ed25519" "$KEYS/router_ed25519.pub" "$DATA/known_hosts"
        ok "eski router SSH anahtarı silindi (artık router kendisi rapor gönderiyor)"
    fi
    if [ -f "$KEYS/deploy_ed25519" ]; then
        git -C "$APP" config core.sshCommand \
            "ssh -i $KEYS/deploy_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
        ok "git güncellemeleri deploy anahtarını kullanacak"
    fi
    chmod 755 "$APP/bin/nodesk" "$APP/router/topo-collect"
    ln -sfn "$APP/bin/nodesk" /usr/local/bin/nodesk
    ok "komut: /usr/local/bin/nodesk"
}

setup_units() {
    step "Servis (systemd)"
    if [ -f "$UNIT_DIR/nodesk.timer" ]; then
        systemctl disable --now nodesk.timer >/dev/null 2>&1 || true
        rm -f "$UNIT_DIR/nodesk.timer"
        ok "eski 5 dakikalık zamanlayıcı kaldırıldı (tarama artık servisin içinde)"
    fi
    local tmp changed=0
    tmp=$(mktemp)
    render "$APP/deploy/systemd/nodesk.service" > "$tmp"
    if ! cmp -s "$tmp" "$UNIT_DIR/nodesk.service"; then
        install -m 644 "$tmp" "$UNIT_DIR/nodesk.service"; changed=1
    fi
    rm -f "$tmp"
    systemctl daemon-reload
    systemctl enable nodesk.service >/dev/null 2>&1
    # Kod da değişmiş olabilir (update): her kurulumda yeniden başlat
    systemctl restart nodesk.service
    [ $changed -eq 1 ] && ok "servis tanımı güncellendi" || ok "servis tanımı güncel"
    local _
    for _ in $(seq 1 30); do
        if api "$API/api/state" >/dev/null 2>&1; then ok "servis çalışıyor (API 127.0.0.1:8089)"; return 0; fi
        sleep 1
    done
    journalctl -u nodesk.service -n 20 --no-pager -o cat || true
    die "Servis başlamadı (yukarıdaki günlüğe bak)"
}

wait_web() {
    local _
    for _ in $(seq 1 30); do
        if curl -fsS -o /dev/null "http://127.0.0.1:$PORT/" 2>/dev/null; then return 0; fi
        sleep 2
    done
    return 1
}

setup_web() {
    step "Web arayüzü (CasaOS)"
    local compose="$DATA/docker-compose.yml" tmp method
    tmp=$(mktemp --suffix=.yml)
    render "$APP/deploy/docker-compose.yml" > "$tmp"
    method=$(cat "$DATA/deploy_method" 2>/dev/null || echo "")

    if cmp -s "$tmp" "$compose" && web_running; then
        rm -f "$tmp"
        docker exec "$APP_ID" nginx -s reload >/dev/null 2>&1 || true   # nginx.conf değişmiş olabilir
        ok "web arayüzü çalışıyor"
        return 0
    fi
    install -m 644 "$tmp" "$compose"; rm -f "$tmp"

    if [ "$method" != "docker" ] && command -v casaos-cli >/dev/null 2>&1; then
        if casaos-cli app-management list apps 2>/dev/null | grep -qw "$APP_ID"; then
            casaos-cli app-management apply "$APP_ID" -f "$compose" >/dev/null 2>&1 && method=casaos || method=""
        else
            casaos-cli app-management install -f "$compose" >/dev/null 2>&1 && method=casaos || method=""
        fi
        if [ "$method" = casaos ] && wait_web; then
            echo casaos > "$DATA/deploy_method"
            ok "CasaOS uygulaması kuruldu/güncellendi: Nodesk"
            return 0
        fi
        warn "CasaOS üzerinden kurulamadı; docker compose ile kuruluyor"
    fi
    docker compose -p "$APP_ID" -f "$compose" up -d --remove-orphans 2>&1 | grep -vi "memory limit" || true
    wait_web || die "Web arayüzü $PORT portunda yanıt vermiyor (docker logs $APP_ID)"
    echo docker > "$DATA/deploy_method"
    ok "web arayüzü çalışıyor (docker compose)"
}

router_cmd() {
    local ip; ip=$(pi_ip); ip=${ip:-$PI_TS_IP_FALLBACK}
    echo "    ssh pi@$ip sudo nodesk router-script | ssh root@$ROUTER_TS_IP sh"
}

check_router() {
    step "Router ajanı"
    local info
    info=$(api "$API/api/agents" 2>/dev/null | py -c '
import json, sys
a = {x["name"]: x for x in json.load(sys.stdin)}
r = a.get("router")
print(r["received"] if r and r.get("received") else "")' 2>/dev/null || true)
    if [ -n "$info" ]; then
        ok "router son raporu: $info"
    else
        warn "router henüz rapor göndermedi. Laptop'tan şunu çalıştır (tek seferlik):"
        router_cmd
    fi
}

scan_and_wait() {
    local before
    before=$(api "$API/api/state" | py -c 'import json,sys; print(json.load(sys.stdin)["scan"].get("last_end") or "")')
    api_json POST /api/scan >/dev/null || true
    local _
    for _ in $(seq 1 120); do
        sleep 1
        if api "$API/api/state" | py -c '
import json, sys
s = json.load(sys.stdin)["scan"]
sys.exit(0 if not s["running"] and (s.get("last_end") or "") != sys.argv[1] else 1)' "$before" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

summary_lines() {
    [ -f "$WWW/data.json" ] || { echo "  harita: henüz veri yok"; return; }
    py - "$WWW/data.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
nodes = [n for n in d["nodes"] if n["kind"] not in ("internet",) and not n.get("placeholder")]
on = sum(1 for n in nodes if n.get("online"))
print(f"  harita      : {d['generated']}, {on}/{len(nodes)} cihaz çevrimiçi")
by = {}
for n in nodes:
    by.setdefault(n.get("site") or "-", []).append(n)
names = {s["id"]: s["name"] for s in d["sites"]}
for site, ns in by.items():
    print(f"    {names.get(site, site):14}: {len(ns)} cihaz ({sum(1 for n in ns if n.get('online'))} çevrimiçi)")
src = d.get("sources") or {}
bad = [f"{k} ({v.get('error')})" for k, v in src.items() if v and v.get("ok") is False]
if bad:
    print("  sorunlu kaynaklar: " + ", ".join(bad))
for a in d.get("agents", []):
    age = a.get("age_min")
    print(f"  ajan {a['name']:12}: " + (f"son rapor {age:.0f} dk önce" if age is not None else "rapor yok"))
up = (d.get("app") or {}).get("update")
if up:
    print(f"  güncelleme  : {up['latest']} mevcut  ->  sudo nodesk update")
for e in d.get("errors", []):
    print(f"  ! {e}")
PY
}

first_run() {
    step "Tarama"
    if scan_and_wait; then ok "tarama tamamlandı"; summary_lines
    else warn "tarama 2 dakikada bitmedi: sudo nodesk logs"; fi
}

summary() {
    local ip; ip=$(pi_ip); ip=${ip:-$PI_TS_IP_FALLBACK}
    step "Hazır: Nodesk $(app_version) ($(app_rev))"
    echo "  Harita: http://$ip:$PORT   (evde: http://$(hostname -I | awk '{print $1}'):$PORT)"
}

cmd_install() {
    need_root install
    preflight
    setup_dirs
    setup_units
    setup_web
    first_run
    check_router
    summary
}

# ------------------------------------------------------------------ güncelleme
cmd_update() {
    need_root update
    cd "$APP"
    [ -z "$(git status --porcelain --untracked-files=no)" ] \
        || die "app klasöründe elle yapılmış değişiklik var (git -C $APP status). Ayarlar config.toml'da olmalı."
    local old oldv
    old=$(git rev-parse HEAD); oldv=$(app_version)
    step "Depo kontrol ediliyor"
    git fetch --quiet origin "$BRANCH" || die "Depoya ulaşılamadı (deploy anahtarı / internet)."
    if [ "$(git rev-parse "origin/$BRANCH")" = "$old" ]; then
        ok "zaten güncel: $oldv ($(app_rev))"
        rm -f "$DATA/update.json"
        exit 0
    fi
    echo "Gelen değişiklikler:"
    git log --oneline --no-decorate "HEAD..origin/$BRANCH" | sed 's/^/  /'
    echo "$old" > "$DATA/previous_rev"
    git checkout -q -B "$BRANCH" "origin/$BRANCH"
    rm -f "$DATA/update.json"
    ok "kod güncellendi: $oldv → $(app_version)"
    # Yeni sürümün kendi kurulum adımlarıyla devam et
    exec "$APP/bin/nodesk" install
}

cmd_rollback() {
    need_root rollback
    local prev
    prev=$(cat "$DATA/previous_rev" 2>/dev/null) || die "Geri dönülecek önceki sürüm kaydı yok."
    cd "$APP"
    git cat-file -e "$prev:nodesk/server.py" 2>/dev/null \
        || die "Önceki sürüm ($(git show "$prev:VERSION" 2>/dev/null || echo ?)) eski kurulum biçiminde; ona geri dönülemez. Sorun varsa: sudo nodesk logs"
    echo "Geri dönülüyor: $(app_version) ($(app_rev)) → $(git show "$prev:VERSION" 2>/dev/null) (${prev:0:7})"
    git checkout -q --detach "$prev"
    rm -f "$DATA/previous_rev" "$DATA/update.json"
    warn "Bu sürümde sabit kalınır. Tekrar güncellemek için: sudo nodesk update"
    exec "$APP/bin/nodesk" install
}

# ------------------------------------------------------------------ durum / araçlar
cmd_status() {
    echo "${B}Nodesk $(app_version)${N} ($(app_rev)$(git -C "$APP" symbolic-ref -q HEAD >/dev/null || echo ', sabitlenmiş sürüm'))"
    local code
    code=$(cat <<'PY'
import json, sys
s = json.load(sys.stdin)
st, sc = s["settings"], s["scan"]
auto = "açık" if st["auto"] else "KAPALI"
print(f"  servis      : çalışıyor, otomatik tarama {auto}, {st['interval_min']} dakikada bir")
print(f"  son tarama  : {sc.get('last_end') or '-'}  sıradaki: {sc.get('next') or '-'}")
off = [k for k, v in st["sources"].items() if not v]
if off:
    print("  kapalı kaynaklar: " + ", ".join(off))
PY
)
    if api "$API/api/state" >/dev/null 2>&1; then
        api "$API/api/state" | py -c "$code"
    else
        echo "  servis      : ${R}çalışmıyor${N} (sudo nodesk logs)"
    fi
    if web_running; then echo "  web         : çalışıyor (port $PORT)"
    else echo "  web         : ${R}çalışmıyor${N}"; fi
    summary_lines
}

cmd_run() {
    need_root run
    api "$API/api/state" >/dev/null 2>&1 || die "Servis çalışmıyor: sudo systemctl status nodesk"
    echo "Taranıyor…"
    scan_and_wait && summary_lines || warn "tarama 2 dakikada bitmedi"
}

cmd_logs() { journalctl -u nodesk.service -n "${1:-50}" --no-pager -o cat; }

cmd_router_script() {
    need_root router-script
    py -m nodesk agent-script router
}

cmd_agent() {
    need_root agent
    case "${1:-}" in
        add)
            [ -n "${2:-}" ] || die "kullanım: sudo nodesk agent add <ad>   (örn. cloud-arm)"
            py -m nodesk agent-add "$2" "${3:-linux}"
            echo "Yukarıdaki komutu o sunucuda çalıştır. Ajan 5 dakikada bir rapor gönderir." ;;
        list) py -m nodesk agent-list ;;
        remove)
            [ -n "${2:-}" ] || die "kullanım: sudo nodesk agent remove <ad>"
            py -m nodesk agent-remove "$2" ;;
        *) die "kullanım: sudo nodesk agent add|list|remove [ad]" ;;
    esac
}

cmd_uninstall() {
    need_root uninstall
    read -r -p "Nodesk kaldırılsın mı? Veri klasörü ($NODESK_HOME) silinmez. [e/H] " a
    [ "$a" = "e" ] || [ "$a" = "E" ] || { echo "Vazgeçildi."; exit 0; }
    systemctl disable --now nodesk.service nodesk.timer >/dev/null 2>&1 || true
    rm -f "$UNIT_DIR/nodesk.service" "$UNIT_DIR/nodesk.timer"; systemctl daemon-reload
    ok "servis kaldırıldı"
    if [ "$(cat "$DATA/deploy_method" 2>/dev/null)" = casaos ] && command -v casaos-cli >/dev/null; then
        casaos-cli app-management uninstall "$APP_ID" -n >/dev/null 2>&1 || true
    fi
    [ -f "$DATA/docker-compose.yml" ] && docker compose -p "$APP_ID" -f "$DATA/docker-compose.yml" down >/dev/null 2>&1 || true
    ok "web arayüzü kaldırıldı"
    rm -f /usr/local/bin/nodesk
    echo "Kalanlar:"
    echo "  Pi     : sudo rm -rf $NODESK_HOME"
    echo "  Router : ssh root@$ROUTER_TS_IP \"sed -i '/nodesk-agent/d' /etc/crontabs/root; /etc/init.d/cron restart; rm -f /usr/sbin/nodesk-agent /usr/sbin/topo-collect /etc/nodesk-agent.conf\""
    echo "  Sunucu : systemctl disable --now nodesk-agent.timer; rm -f /etc/systemd/system/nodesk-agent.* /usr/local/sbin/nodesk-agent; rm -rf /etc/nodesk"
}

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
    install)        cmd_install ;;
    update)         cmd_update ;;
    rollback)       cmd_rollback ;;
    status)         cmd_status ;;
    run)            cmd_run ;;
    logs)           shift; cmd_logs "${1:-50}" ;;
    router-script)  cmd_router_script ;;
    agent)          shift; cmd_agent "$@" ;;
    uninstall)      cmd_uninstall ;;
    version|-v|--version) echo "$(app_version) ($(app_rev))" ;;
    ""|help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
